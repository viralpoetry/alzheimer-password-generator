{
  "name": "Alzheimer password generator",
  "description": "Derive a cryptographically secure password from the web page address, salt and user provided secret passphrase.",
  "version": "1.0",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "main.js"
  },
  "content_scripts": [{
    "all_frames": false,
    "matches": ["http://*/*", "https://*/*"],
    "js": [
      "lib/pbkdf2.js",
      "crypto_helpers.js",
      "content_script.js"
    ]
  }],
  "web_accessible_resources": [{
    "resources": ["css/custom.css"],
    "matches": ["<all_urls>"]
  }],
  "icons": {
    "128": "img/icon.png"
  },
  "action": {
    "default_icon": "img/icon.png"
  },
  "manifest_version": 3
}
